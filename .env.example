# Frontend public variables (Vite injects these into the browser bundle)
# Only publishable, non-secret values use the VITE_ prefix.

# Environment label: local | preview | production
VITE_APP_ENV=local

# Frontend origin for auth redirects and same-origin checks
VITE_APP_ORIGIN=http://localhost:5173

# Vite base path for asset routing
# Local: /
# GitHub Pages: /krunditark.ee/
# Production: /
VITE_BASE_PATH=/

# Supabase public configuration (publishable key — safe to expose in browser)
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Optional future public variables: approved map-style URLs, public feature flags, etc.
